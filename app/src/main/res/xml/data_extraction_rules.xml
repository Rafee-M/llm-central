<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12+ (API 31+). Android can copy app data to the user's Google Drive backup
    ("cloud-backup") and to a new phone ("device-transfer"). We keep settings (shared preferences, which
    include user scripts) but EXCLUDE:
      * app_webview/          = WebView data: login cookies/sessions for every account, site storage, cache.
                                A session copied to another place is a security risk, and logging in again
                                on a new phone is expected behaviour.
      * duck_chats_cache.json / duck_chats.db = offline chat history (private conversations).
      * anydoc_wasm_bg.wasm   = 6.7 MB document converter of older versions (the app deletes it at
                                start; excluded in case a backup runs before that).
    Docs: https://developer.android.com/identity/data/autobackup#include-exclude-android-12
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="duck_chats_cache.json" />
        <exclude domain="database" path="duck_chats.db" />
        <exclude domain="file" path="anydoc_wasm_bg.wasm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="duck_chats_cache.json" />
        <exclude domain="database" path="duck_chats.db" />
        <exclude domain="file" path="anydoc_wasm_bg.wasm" />
    </device-transfer>
</data-extraction-rules>
