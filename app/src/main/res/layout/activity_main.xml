<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen layout: native top bar (provider switcher + settings) above the web content.
    The RelativeLayout below is the "tab container": it holds duck.ai's WebView (chatWebView) and,
    added at runtime by web/TabManager, one WebView per other provider, with the loading bar on top.
-->
<!-- fitsSystemWindows: Android 7–10. On Android 11+ ThemeManager.fitContent pads this view itself,
     so the top strip can be used while the status bar is hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/chatWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:indeterminate="true"
            android:visibility="gone" />
    </RelativeLayout>
</LinearLayout>
