<?xml version="1.0" encoding="utf-8"?>
<!--
    Start-up colours of the native top bar (LIGHT mode; values-night/ has the dark ones).
    They are only visible for a split second: MainActivity.applyTheme() immediately repaints the bar
    with the user's theme (palette / Material You / dark mode) from theme/ThemeManager.
-->
<resources>
    <color name="top_bar_background">#FFF7F2FA</color>  <!-- M3 surface container low -->
    <color name="chip_background">#FFECE6F0</color>     <!-- M3 surface container high -->
    <color name="on_surface">#FF1D1B20</color>          <!-- main text -->
    <color name="on_surface_variant">#FF49454F</color>  <!-- secondary text / icons -->
</resources>
