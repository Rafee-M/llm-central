<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Key for data a tab's WebView carries around with it (View.setTag(key, value)): its desktop-site
         state (web/DesktopMode). Stored on the view itself, so it's freed together with the tab. -->
    <item name="tag_desktop_mode" type="id" />
    <!-- web/PageZoom keeps its per-tab state here ("Pinch zooms the page"). -->
    <item name="tag_page_zoom" type="id" />
    <!-- web/TabManager: the address of a page that failed to load in this tab (retry screen, O-M4). -->
    <item name="tag_load_failed" type="id" />
    <!-- web/SignInUserAgent: the user agent a tab or pop-up had before Google's sign-in page needed another one. -->
    <item name="tag_sign_in_ua" type="id" />
</resources>
