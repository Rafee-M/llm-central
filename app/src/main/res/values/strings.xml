<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The app's name. Lint calls it "unused" because it can't see its uses: app/build.gradle (the manifest
         placeholder appName) and the About window. Not translated: the name is the same in every language. -->
    <string name="app_name" translatable="false" tools:ignore="UnusedResources">LLM Central</string>
    <string name="download">Download started:</string>
    <string name="url_copied">copied to clipboard</string>
    <!-- Downloads (downloads/Downloader) -->
    <string name="download_failed">The file couldn\'t be saved.</string>
    <string name="download_needs_newer_webview">Saving this file needs a newer Android System WebView (update it from the Play Store).</string>
    <string name="download_too_large">This file is too large to save (over about 75 MB).</string>
    <!-- Top bar (provider switcher) -->
    <string name="switch_provider">Switch account</string>
    <string name="open_settings">Settings</string>
    <!-- Find in page: the top bar's search button and the find bar at the bottom (ui/FindBar). -->
    <string name="find_in_page">Find in page</string>
    <string name="find_previous">Previous match</string>
    <string name="find_next">Next match</string>
    <string name="find_close">Close find in page</string>
    <string name="dropdown_arrow" translatable="false">▾</string>
    <string name="reload_page">Reload page</string>
    <string name="tab_unloaded">Unloaded. Tap to load</string>
    <!-- Retry screen when a page can't be loaded (no connection, site down): web/LoadErrors, O-M4. -->
    <string name="tab_load_failed">Couldn\'t load this page. Tap to retry</string>
    <!-- Account menu (ui/SwitcherPopup): the icon row and the "Active accounts" switch. -->
    <string name="reset_text_size">Reset text size</string>
    <!-- The ✕ on an account's row in the account menu (label for screen readers and the long-press tooltip). -->
    <string name="unload_account">Unload %1$s</string>
    <string name="clear_cache">Clear cache</string>
    <string name="cache_cleared">Cache cleared. Logins stay.</string>
    <string name="active_accounts">Active accounts</string>
    <string name="active_accounts_off">Show only loaded accounts</string>
    <string name="active_accounts_count">Showing %1$d of %2$d</string>
    <string name="account_loaded">loaded</string>
    <string name="text_size_reset">Text size reset to 100 %</string>
    <string name="current_account">current</string>
    <!-- Text-selection menu entry (PROCESS_TEXT); sends the selected text to the share account. -->
    <string name="ask_ai">Ask AI</string>
    <!-- Close button of a sign-in pop-up window (web/PopupWindows). -->
    <string name="close_window">Close window</string>
    <!-- Top bar toggle (web/DesktopMode) and what screen readers say about its state. -->
    <string name="desktop_site">Desktop site</string>
    <!-- Account menu button: the same as Settings → Appearance → "Hide status bar". -->
    <string name="hide_status_bar">Hide status bar</string>
    <string name="state_on">On</string>
    <string name="state_off">Off</string>
    <string name="microphone_denied">Voice needs the microphone. You can allow it in App info → Permissions → Microphone.</string>
    <!-- A shared file was refused: only other apps' content:// files can be attached (storage/SharedFiles). -->
    <string name="share_refused">This file can\'t be shared to LLM Central. Share it from a files or gallery app instead.</string>
    <string name="offline_chats_off">Offline chats are off. Turn them on in Settings → Data &amp; tools.</string>
</resources>